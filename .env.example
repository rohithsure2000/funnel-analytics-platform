# Copy this file to .env and fill in real values for production use.
# For local development, DB_BACKEND=sqlite works out of the box with no
# other configuration -- the app will create data/processed/warehouse.db.

# --- Backend selection ---
DB_BACKEND=sqlite   # sqlite | snowflake

# --- Snowflake connection (only required when DB_BACKEND=snowflake) ---
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=PRODUCT_ANALYTICS
SNOWFLAKE_SCHEMA=FUNNEL

# --- Optional: alerting integrations referenced in the README roadmap ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL_FROM=
